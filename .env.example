# Required: secret token for the /api/ingest endpoint
# Generate with: openssl rand -hex 32
INGEST_SECRET=replace-with-a-random-secret

# Database connection URL
DATABASE_URL=postgresql://user:password@localhost:5432/positivenews

# Redis connection URL (optional; defaults to local Redis on 6379)
REDIS_URL=redis://127.0.0.1:6379

# Admin panel auth (NextAuth v5)
# AUTH_SECRET is required in production — generate with: openssl rand -hex 32
AUTH_SECRET=replace-with-a-random-secret
# URL of the site including basePath, used by NextAuth for callbacks
AUTH_URL=http://localhost:3001/news
# Admin login credentials
ADMIN_EMAIL=admin@example.com
# Generate hash with: node -e "require('bcryptjs').hash('your-password',12).then(console.log)"
ADMIN_PASSWORD_HASH=replace-with-bcrypt-hash

# Adaptive filtering thresholds (these are the defaults — only set to override)
KEYWORD_MIN_HITS=5
KEYWORD_MIN_IPS=2
KEYWORD_STALE_DAYS=30
KEYWORD_AUTO_ACTIVATE_DAYS=7

# TypeSafe Jev: shadow evaluation by default; primary curator with CURATOR_PROVIDER=jev
# TYPESAFE_API_KEY=
# Optional overrides (defaults: jev-1.13.0 on https://api.typesafe.ai)
# TYPESAFE_DEFAULT_MODEL=jev-1.13.0
# TYPESAFE_BASE_URL=

# Public feed only shows articles published within this many days (default 14).
# Older articles stay in the database as training data.
# FEED_MAX_AGE_DAYS=14

# Curator selection: jev | openai | ollama | none
# Default when unset or empty: ollama, regardless of API keys.
# Legacy Ollama upgrades: provider selection stays unchanged unless CURATOR_PROVIDER is set.
# CURATOR_PROVIDER=jev
# Fallback: openai | ollama | none. Default none
# CURATOR_FALLBACK=none
# Jev verdict thresholds (same rule as /news/admin/jev: deriveVerdict in src/lib/jev.ts)
# Keep iff positiveP >= POSITIVE, upliftingP >= UPLIFTING and topCategoryP <= CATEGORY_VETO
# JEV_KEEP_POSITIVE_THRESHOLD=0.5
# JEV_KEEP_UPLIFTING_THRESHOLD=0.5
# JEV_CATEGORY_VETO_THRESHOLD=0.6
# Per-request timeout for all curator providers, milliseconds
# CURATOR_TIMEOUT_MS=30000
# Overall curation budget shared by primary and fallback, milliseconds
# Missing or blank durations use defaults; otherwise positive integers only
# CURATOR_BUDGET_MS=120000

# OpenAI-compatible provider. No default key
# CURATOR_OPENAI_API_KEY=
# Default Mistral endpoint and Ministral 3 8B model
# CURATOR_OPENAI_BASE_URL=https://api.mistral.ai/v1
# CURATOR_OPENAI_MODEL=ministral-8b-2512
# Gemini alternative: https://generativelanguage.googleapis.com/v1beta/openai
# Gemini model: gemini-2.5-flash-lite
# Scaleway Generative APIs EU alternative: https://api.scaleway.ai/v1
# Set CURATOR_OPENAI_MODEL to a model available at the selected endpoint

# Ollama defaults, contacted when selected as primary or fallback
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=gemma3:4b
# Production explicitly overrides OLLAMA_MODEL=llama3.2:1b
# Optional Laya shadow evaluation, skipped when unset
# LAYA_URL=
